# ============================================================
#  Qspot-API — environment variables
#  Copy to .env and fill in the values.
# ============================================================

# ── Server ──────────────────────────────────────────────────
# 5000 is taken by macOS AirPlay Receiver, so we use 5001 locally
PORT=5001
NODE_ENV=development
# Comma-separated list of allowed origins, or * to allow any (dev default).
CORS_ORIGIN=*

# ── Database (MongoDB Atlas SRV string, or a local mongodb:// URI) ──
# Local development default used by the seed/test commands:
# MONGODB_URI=mongodb://127.0.0.1:27017/qspot
MONGODB_URI=
# Connection pool per API instance. Keep (instances x MONGO_MAX_POOL_SIZE) under
# the database tier's connection limit. A bigger pool absorbs a burst of
# students faster when the database is remote (measured: 100 -> 200 cut the
# submit burst for 500 students from ~2.3 s to ~1.8 s). Defaults shown.
# MONGO_MAX_POOL_SIZE=100
# MONGO_MIN_POOL_SIZE=10
# MONGO_WAIT_QUEUE_TIMEOUT_MS=10000

# ── Quizzes ─────────────────────────────────────────────────
# Minutes after a quiz ends during which a student who STARTED it while it was
# live may still submit (answers finished offline). 0 = strict end time.
# QUIZ_SUBMIT_GRACE_MINUTES=5

# ── Login ───────────────────────────────────────────────────
# Wrong date-of-birth tries allowed per internet address per 15 minutes. A
# school can share one address, so keep this well above a classroom's typos.
# Each phone number separately allows 5. Default shown.
# LOGIN_MAX_FAILED_PER_IP=300

# ── Admin panel login + JWT signing ─────────────────────────
JWT_SECRET=
ADMIN_USERNAME=
# plain text OR a bcrypt hash — both work
ADMIN_PASSWORD=

# ── DigitalOcean Spaces (images / video / audio uploads) ────
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_CDN_ENDPOINT=
DO_SPACES_FOLDER=uploads
# Image/PDF cover uploads (banners, subject/course covers, speaker photos).
DO_MAX_FILE_SIZE=5242880
# Handout uploads (PDF workbooks/notes) are allowed to be larger than images.
DO_HANDOUT_MAX_FILE_SIZE=26214400
# Admin video uploads (POST/PUT /api/videos with a `video` file field).
DO_VIDEO_MAX_FILE_SIZE=524288000

# ── Dxing — WhatsApp OTP login for the mobile app ───────────
DXING_INSTANCE_ID=
DXING_API_KEY=

# ── Test login (bypasses real WhatsApp OTP for this one number, in every
#    environment including production) ─────────────────────
# leave empty to turn it off
TEST_LOGIN=
TEST_OTP=
# Optional: name/class given to the test login if it has to be created.
TEST_LOGIN_NAME=Test Student
TEST_LOGIN_CLASS=8

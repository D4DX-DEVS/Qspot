# Copy to .env.local and change what you need.

# Development only: where `npm run dev` forwards /api calls.
# Defaults to the live API the mobile app uses. For a local API:
#   VITE_API_PROXY_TARGET=http://localhost:5001
VITE_API_PROXY_TARGET=

# Production build only: the API address the built site calls.
# Leave empty to use the live API. The API's CORS_ORIGIN must allow the
# site's address.
VITE_API_BASE_URL=

# The registration screen is built but hidden. Set to true to show the
# "Register Now" link and the /register page.
VITE_ENABLE_REGISTRATION=false
